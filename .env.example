# Sample Pack Alchemist — optional environment variables.
#
# The app is fully static: it runs without any configuration. These variables
# only affect local tooling and CI; none are required to open index.html.

# Local dev server port (scripts/serve.mjs). Not used by GitHub Pages.
SPA_PORT=8080

# Override the base URL used when README links are regenerated locally.
# Leave blank to derive it from the git remote.
SPA_HOMEPAGE=https://zazieproductions.github.io/Sample-Pack-Alchemist/

# Playwright/Chromium: set to "prefer-sparticuz" (default) or "system" to use a
# locally installed browser instead of the bundled serverless Chromium.
SPA_BROWSER=prefer-sparticuz
